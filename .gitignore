venv/*
.idea/*
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
# Weather-page credentials live outside the repository; never commit any.
*.credentials
# Created by running with sites/minerva/dispatch.example.json in place
/sites/*/dispatch-state.json*
/sites/*/too-dropbox/
# Request-API tokens (hashed, but still) live outside the repository.
*tokens*.json
# Packaging output (pip install ., python -m build)
*.egg-info/
build/
dist/
# Service-account keys and other secrets live in /etc/robofast/secrets/,
# never in a work tree (docs/deploy.md); a backstop against `git add -A`.
*service-account*.json
*service_account*.json
secrets/
